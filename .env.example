# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# Puerto HTTP del microservicio (por defecto 3030)
PORT=3030

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# URL base de ms_security, sin barra final. Obligatoria: sin ella todas las rutas responden 503.
MS_SECURITY=http://localhost:8181

# ms-notificaciones (Flask). Misma clave que EMAIL_SERVICE_API_KEY de ese servicio.
# Sin estas variables los partidos se crean igual, pero no se envían correos.
EMAIL_SERVICE_URL=http://127.0.0.1:5000
EMAIL_SERVICE_API_KEY=
