# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# Puerto HTTP del microservicio (por defecto 3030)
PORT=3030

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# URL base de ms_security, sin barra final. Obligatoria: sin ella todas las rutas responden 503.
MS_SECURITY=http://localhost:8181
